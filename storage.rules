rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // File aplikasi disimpan pada:
    // uploads/{firebaseUid}/{filename}
    match /uploads/{userId}/{allPaths=**} {

      // Foto produk, rumah pompa, lokasi, dan kartu website
      // perlu dapat tampil pada halaman publik.
      allow read: if true;

      // User hanya boleh upload ke folder UID Firebase miliknya sendiri.
      // Maksimum file 5 MB dan hanya tipe image.
      allow create, update: if request.auth != null
                            && request.auth.uid == userId
                            && request.resource.size < 5 * 1024 * 1024
                            && request.resource.contentType.matches('image/.*');

      // Pemilik file boleh menghapus file pada folder UID sendiri.
      allow delete: if request.auth != null
                    && request.auth.uid == userId;
    }

    // Selain folder uploads ditutup.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
