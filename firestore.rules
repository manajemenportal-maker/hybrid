rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Aplikasi saat ini menyimpan database bersama pada:
    // appData/main
    match /appData/main {

      // Halaman publik perlu membaca produk, CPCL, rumah pompa,
      // pengaturan website, dan status garansi.
      allow read: if true;

      // Hanya user yang sudah login Firebase Authentication
      // yang boleh menyimpan perubahan.
      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly(['payload', 'updatedAt'])
                    && request.resource.data.keys().hasAll(['payload', 'updatedAt'])
                    && request.resource.data.updatedAt == request.time;

      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data)
                         .affectedKeys()
                         .hasOnly(['payload', 'updatedAt'])
                    && request.resource.data.keys().hasOnly(['payload', 'updatedAt'])
                    && request.resource.data.keys().hasAll(['payload', 'updatedAt'])
                    && request.resource.data.updatedAt == request.time;

      // Tidak boleh menghapus database utama dari aplikasi client.
      allow delete: if false;
    }



    // Statistik pengunjung publik. Setiap penulisan hanya boleh menaikkan counter 1 angka.
    // Aplikasi membatasi satu hit per browser per hari melalui localStorage.
    match /visitorDaily/{day} {
      allow read: if true;

      allow create: if request.resource.data.keys().hasOnly(['count', 'updatedAt'])
                    && request.resource.data.keys().hasAll(['count', 'updatedAt'])
                    && request.resource.data.count == 1
                    && request.resource.data.updatedAt == request.time;

      allow update: if request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['count', 'updatedAt'])
                    && request.resource.data.keys().hasOnly(['count', 'updatedAt'])
                    && request.resource.data.count == resource.data.count + 1
                    && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    // Foto referensi rumah pompa disimpan sebagai dokumen terpisah
    // agar menu ini tetap bekerja pada paket Firebase Spark tanpa Storage.
    // Foto dikompres oleh aplikasi dan dibatasi agar tiap dokumen tetap kecil.
    match /houseImages/{imageId} {
      allow read: if true;

      allow create, update: if request.auth != null
                            && request.auth.token.email == 'kalimajasuryaalam@gmail.com'
                            && request.resource.data.keys().hasOnly(['data', 'contentType', 'updatedAt'])
                            && request.resource.data.keys().hasAll(['data', 'contentType', 'updatedAt'])
                            && request.resource.data.data is string
                            && request.resource.data.data.size() <= 500000
                            && request.resource.data.contentType == 'image/jpeg'
                            && request.resource.data.updatedAt == request.time;

      allow delete: if request.auth != null
                    && request.auth.token.email == 'kalimajasuryaalam@gmail.com';
    }

    // Semua collection/document lain ditutup secara default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
