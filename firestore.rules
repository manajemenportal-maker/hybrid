rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Aplikasi saat ini menyimpan database bersama pada:
    // appData/main
    match /appData/main {

      // Halaman publik perlu membaca produk, CPCL, rumah pompa,
      // pengaturan website, dan status garansi.
      allow read: if true;

      // Hanya user yang sudah login Firebase Authentication
      // yang boleh menyimpan perubahan.
      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly(['payload', 'updatedAt'])
                    && request.resource.data.keys().hasAll(['payload', 'updatedAt'])
                    && request.resource.data.updatedAt == request.time;

      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data)
                         .affectedKeys()
                         .hasOnly(['payload', 'updatedAt'])
                    && request.resource.data.keys().hasOnly(['payload', 'updatedAt'])
                    && request.resource.data.keys().hasAll(['payload', 'updatedAt'])
                    && request.resource.data.updatedAt == request.time;

      // Tidak boleh menghapus database utama dari aplikasi client.
      allow delete: if false;
    }

    // Semua collection/document lain ditutup secara default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
